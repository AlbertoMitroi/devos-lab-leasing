{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Audience": "api://lab-leasing"
  },
  "ConnectionStrings": {
    "LeasingDb": ""
  },
  "Clients": {
    "Pricing": {
      "BaseAddress": "http://localhost:5081/"
    },
    "RateCards": {
      "BaseAddress": "http://localhost:5081/"
    }
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMqHost": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "lab",
      "Password": ""
    },
    "Queues": {
      "CreditCheckRequests": "credit-check-requests",
      "CreditCheckResponses": "leasing-credit-check-responses",
      "NoticeOutbox": "notice-outbox",
      "Projections": "leasing-ordered-projection-messages"
    },
    "CreditBureauSimulator": false
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "SchemaRegistryUrl": "http://localhost:8081",
    "ConsumerGroup": "leasing",
    "Topics": {
      "Applications": "lease-applications-v1",
      "Enrichment": "lease-application-enrichment-v1",
      "Contracts": "leasing-contracts-v1"
    }
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "Indexes": {
      "Flows": "leasing-flows"
    }
  },
  "WorkTeams": {
    "UnderwritingTeam": { "Members": [] },
    "RiskTeam": { "Members": [] },
    "SalesTeam": { "Members": [] },
    "OperationsTeam": { "Members": [] }
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
