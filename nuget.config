<?xml version="1.0" encoding="utf-8"?>
<!--
  The "github" source needs credentials. They are never stored here: set
  NuGetPackageSourceCredentials_github="Username=<user>;Password=<token with read:packages>"
  in the environment (the Dockerfile reads the token from a build secret).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/AlbertoMitroi/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Lab.Core.*" />
      <package pattern="Pricing.Client" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
